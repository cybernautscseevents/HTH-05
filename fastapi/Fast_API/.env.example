# FastAPI Backend Environment Configuration Template
# Copy this file to .env and fill in the values for your local or deployment environment.

# Local/other database connection. URL-encode credentials if you construct this URL manually.
DATABASE_URL=

# Aiven MySQL (when AIVEN_DB_PASSWORD is set, these settings take precedence over DATABASE_URL).
# TLS validates the server certificate with this CA file and checks the hostname.
AIVEN_DB_HOST=project-mysql-kritharthjain6-e607.c.aivencloud.com
AIVEN_DB_PORT=18310
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=
AIVEN_CA_CERT=C:/path/to/ca.pem

# JWT Secret Key for token generation and verification
SAATHI_SECRET_KEY=

# Seed account credentials (used only by create_doctor.py and create_receptionist.py)
INITIAL_DOCTOR_PASSWORD=
INITIAL_RECEPTIONIST_PASSWORD=

# Allowed CORS Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Hospital bed inventory; new bed numbers are assigned when configured beds fill.
GENERAL_WARD_BED_COUNT=0
SPECIAL_WARD_BED_COUNT=0

# GroqCloud discharge document analysis (backend only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
